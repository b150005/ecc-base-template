# compliance.yml.example
#
# Per ADR-011, the compliance-checklist Skill ships default-off. To enable
# it for your project, copy this file to `.claude/compliance.yml` and set
# `enabled: true` plus a non-empty `target_jurisdictions` list. The Skill
# refuses to run when either condition is missing.
#
# This file controls only Skill activation. The Skill itself lives at
# `.claude/skills/compliance-checklist/SKILL.md`. Do not duplicate
# Skill content in this config — keep policy at this layer, content at
# the Skill layer.

compliance:
  # Master switch. Default false. When false, the Skill is never invoked,
  # even if other agents reference it.
  enabled: false

  # Declared jurisdictions for evaluation. The Skill refuses to run when
  # `enabled: true` and this list is empty or absent. The Skill never
  # infers jurisdiction — declaration is a project assertion.
  #
  # Currently supported (covered by jurisdiction reference files):
  #   - JP        — Japan (電気通信事業法 / 特定商取引法 /
  #                 改正個人情報保護法 / 資金決済法)
  #   - EU        — European Union (GDPR, ePrivacy, DSA)
  #   - US-CA     — California (CCPA / CPRA, CalOPPA, Shine the Light)
  #   - platform  — Apple App Store + Google Play store policies
  #
  # If your project needs a jurisdiction not listed here, contribute a
  # jurisdiction reference file at
  # `.claude/skills/compliance-checklist/jurisdictions/<code>.md` and
  # declare the code below. The Skill does not silently extrapolate
  # between jurisdictions.
  target_jurisdictions:
    - JP
    # - EU
    # - US-CA
    # - platform

  # Optional: operator-asserted size-threshold answers, used to refine
  # findings that depend on operator scale (e.g. CCPA's $25M revenue
  # threshold). Leave commented out unless you want the Skill to skip
  # the size-threshold human prompt.
  #
  # operator_attestations:
  #   us_ca_meets_ccpa_threshold: false  # Operator asserts revenue / scale below CCPA thresholds
  #
  # Note: per Invariant 1 (no negative-applicability claims), even an
  # explicit `false` here does not cause the Skill to mark CCPA as
  # `out of scope`. It causes the Skill to render
  # `may apply, verify (operator-asserted below threshold — re-verify
  # if revenue or scale changes)`.

  # Optional: re-verification cadence override (defaults: 180 days for
  # JP/EU/US-CA, 90 days for platform per the higher rate of policy
  # change at the platform layer).
  #
  # reverification_days:
  #   JP: 180
  #   EU: 180
  #   US-CA: 180
  #   platform: 90
